# Copia este archivo como ".env" (en esta misma carpeta backend/) y completa tus datos de Supabase.
# Supabase > Project Settings > Database > Connection string > JDBC > "Session pooler"

NOVAPOP_DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
NOVAPOP_DB_USER=postgres.TU_PROJECT_REF
NOVAPOP_DB_PASSWORD=TU_CLAVE_DE_BASE_DE_DATOS

# Cualquier texto largo y aleatorio (mínimo 32 caracteres)
NOVAPOP_JWT_SECRET=pon-aqui-una-clave-larga-y-aleatoria-de-al-menos-32-caracteres

# Opcional: clave de TMDB para database/tmdb/importar-tmdb.mjs
NOVAPOP_TMDB_KEY=
